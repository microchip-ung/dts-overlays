// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * lan966x-pcb8385-lan9645x-evb-rev-c.dts - Device Tree file for LAN966X-PCB8385
 * board driving Lan9645x EVB Rev C.
 *
 * Changes from Rev B:
 *
 * - SFP1 rate select moved GPIO 28 -> 45
 *
 * Copyright (C) 2026 Microchip Technology Inc. and its subsidiaries
 */
// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/dts-v1/;
/plugin/;
#include "sama7d65-pinfunc.h"
#include "atmel-flexcom.h"
#include "clock/at91.h"
#include "pinctrl/at91.h"
#include "gpio.h"
#include "irq.h"
#include "phy-lan9645x-serdes.h"

&{/}
{
	model = "Microchip SAMA7D65 Curiosity LAN96459 Gigabit Switch";

	lan9645x_clock: lan9645x-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <165625000>;
	};
};

&flx4 {
	atmel,flexcom-mode = <ATMEL_FLEXCOM_MODE_SPI>;
	status = "okay";
};

&gmac1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gmac1_default
		     &pinctrl_gmac1_mdio_gpio
		     &pinctrl_gmac1_txck_default
		     &pinctrl_gmac1_phy_irq>;
	phy-mode = "rgmii-id";
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};

	ethernet-phy@1 {
		status = "disabled";
	};
};

&i2c10 {
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <0>, <0>;
	status = "okay";

	eeprom@50 {
		compatible = "atmel,24c64";
		reg = <0x50>;
		pagesize = <32>;
		status = "okay";
	};

	eeprom@54 {
		compatible = "atmel,24c01";
		reg = <0x54>;
		pagesize = <8>;
		status = "okay";
	};
};

&pioa {
	pinctrl_gmac1_mdio_gpio: gmac1-mdio-gpio {
		pinmux = <PIN_PD25__GPIO>,
			 <PIN_PD26__GPIO>;
		bias-disable;
	};

	pinctrl_spi4_default: spi4-default{
		pinmux = <PIN_PA18__FLEXCOM4_IO0>,	/* MOSI */
			 <PIN_PA17__FLEXCOM4_IO1>,	/* MISO */
			 <PIN_PA16__FLEXCOM4_IO2>,	/* SPCK */
			 <PIN_PA15__FLEXCOM4_IO3>,	/* CS0 */
			 <PIN_PA14__FLEXCOM4_IO4>,	/* CS1 */
			 <PIN_PA19__FLEXCOM4_IO5>,	/* CS2 */
			 <PIN_PA20__FLEXCOM4_IO6>;	/* CS3 */
		bias-disable;
	};
};

&spi4 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi4_default>;
	status = "okay";

	lan9645x_soc: soc@3 {
		compatible = "microchip,lan9645x-spi";
		reg = <3>;
		spi-max-frequency = <25000000>;
		#address-cells = <1>;
		#size-cells = <0>;

		lan9645x_i2c0: i2c@4c0000 {
			reg = <0>;
			reg-names = "i2c";
			compatible = "mchp,lan9645x-i2c";
			pinctrl-0 = <&lan9645x_i2c0_sda_pins>;
			pinctrl-names = "default";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupt-parent = <&lan9645x_irq>;
			interrupts-extended = <&lan9645x_irq 9>;
			i2c-sda-hold-time-ns = <300>;
			clock-frequency = <100000>;
			clocks = <&lan9645x_clock>;
		};

		i2cmux {
			compatible = "i2c-mux-pinctrl";
			#address-cells = <1>;
			#size-cells = <0>;
			i2c-parent = <&lan9645x_i2c0>;
			pinctrl-names = "i2c_sfp0", "i2c_sfp1", "idle";
			pinctrl-0 = <&lan9645x_i2c0_scl0_pins>;
			pinctrl-1 = <&lan9645x_i2c0_scl1_pins>;
			pinctrl-2 = <&lan9645x_i2cmux_pins>;

			i2c_sfp0: i2c@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;
			};

			i2c_sfp1: i2c@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};

		lan_sfp0: sfp0 {
			compatible = "sff,sfp";
			i2c-bus = <&i2c_sfp0>;
			tx-disable-gpios   = <&gpio_lan9645x 11 GPIO_ACTIVE_HIGH>;
			mod-def0-gpios     = <&gpio_lan9645x 29 GPIO_ACTIVE_LOW>;
			los-gpios          = <&gpio_lan9645x 42 GPIO_ACTIVE_HIGH>;
			rate-select0-gpios = <&gpio_lan9645x 39 GPIO_ACTIVE_HIGH>;
		};

		lan_sfp1: sfp1 {
			compatible = "sff,sfp";
			i2c-bus = <&i2c_sfp1>;
			tx-disable-gpios   = <&gpio_lan9645x 44 GPIO_ACTIVE_HIGH>;
			mod-def0-gpios     = <&gpio_lan9645x 12 GPIO_ACTIVE_LOW>;
			los-gpios          = <&gpio_lan9645x 8 GPIO_ACTIVE_HIGH>;
			rate-select0-gpios = <&gpio_lan9645x 45 GPIO_ACTIVE_LOW>;
		};

		mdio@4098 { // miim0
			reg = <0x4098>;
			reg-names = "gcb_miim0";
			compatible = "microchip,lan966x-miim";
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-names = "default";
			pinctrl-0 = <&rgmii0_pins>;

			rgmii0: ethernet-phy@0 {
				reg = <0>;
				status = "disabled";
			};

			rgmii1: ethernet-phy@1 {
				reg = <1>;
				status = "disabled";
			};

		};

		mdio@40bc { // miim1
			reg = <0x40bc>, <0>;
			reg-names = "gcb_miim1", "phy";
			compatible = "microchip,lan966x-miim";
			#address-cells = <1>;
			#size-cells = <0>;

			cuphy0: ethernet-phy@1 {
				reg = <0x1>;
				interrupts-extended = <&lan9645x_irq 12>;
			};

			cuphy1: ethernet-phy@2 {
				reg = <0x2>;
				interrupts-extended = <&lan9645x_irq 13>;
			};

			cuphy2: ethernet-phy@3 {
				reg = <0x3>;
				interrupts-extended = <&lan9645x_irq 14>;
			};

			cuphy3: ethernet-phy@4 {
				reg = <0x4>;
				interrupts-extended = <&lan9645x_irq 15>;
			};

			cuphy4: ethernet-phy@5 {
				reg = <0x5>;
				status = "disabled";
				interrupts-extended = <&lan9645x_irq 16>;
			};

		};

		lan9645x_irq: interrupt-controller@52001c {
			compatible = "microchip,lan9645x-oic";
			reg = <0>;
			reg-names = "cpu_intr";
			// dst=2 is external IRQ0
			microchip,dst_target = <2>;
			microchip,drv_mode   = <1>;
			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-parent = <&pioa>;
			interrupts-extended = <&pioa PIN_PE3 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "external-irq";
		};

		lan9645x: ethernet-switch@1 {
			compatible = "microchip,lan9645x-switch";
			reg = <0>;
			interrupts-extended = <&lan9645x_irq 27>, <&lan9645x_irq 26>, <&lan9645x_irq 17>;
			interrupt-names = "lan9645x-ptp", "lan9645x-ptp-ext", "lan9645x-ana";
			pinctrl-0 = <&lan9645x_leds>, <&lan9645x_ptp1_pins>, <&lan9645x_ptp2_pins>;
			pinctrl-names = "default";
			microchip,shadow-ports = <4 8>;
			ethernet-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				lan0: port@0 {
					reg = <0>;
					label = "lan0";
					phy-mode = "gmii";
					phy-handle = <&cuphy0>;
				};

				lan1: port@1 {
					reg = <1>;
					label = "lan1";
					phy-mode = "gmii";
					phy-handle = <&cuphy1>;
					microchip,led-drive-mode = <1 3>;
				};

				lan2: port@2 {
					reg = <2>;
					label = "lan2";
					phy-mode = "gmii";
					phy-handle = <&cuphy2>;
				};

				lan3: port@3 {
					reg = <3>;
					label = "lan3";
					phy-mode = "gmii";
					phy-handle = <&cuphy3>;
				};

				lan4: port@4 {
					reg = <4>;
					label = "lan4";
					status = "disabled";
					phy-mode = "gmii";
					phy-handle = <&cuphy4>;
				};

				lan5: port@5 {
					reg = <5>;
					label = "lan5";
					phys = <&lan9645x_serdes 5 LAN9645X_SERDES6G(0)>;
					phy-mode = "sgmii";
					managed = "in-band-status";
					sfp = <&lan_sfp0>;
				};

				lan6: port@6 {
					reg = <6>;
					label = "lan6";
					phy-mode = "sgmii";
					managed = "in-band-status";
					phys = <&lan9645x_serdes 6 LAN9645X_SERDES6G(1)>;
					sfp = <&lan_sfp1>;
				};

				lan7: port@7 {
					reg = <7>;
					label = "lan7";
					phy-mode = "rgmii";
					status = "okay";
					ethernet = <&gmac1>;
					fixed-link {
						speed = <1000>;
						full-duplex;
						pause;
					};
				};

				lan8: port@8 {
					reg = <8>;
					label = "lan8";
					phy-handle = <&rgmii1>;
					phy-mode = "rgmii-id";
					status = "disabled";
				};
			};
		};

		gpio_lan9645x: pinctrl@4028 {
			compatible = "microchip,lan9645x-pinctrl";
			reg = <0>;
			reg-names = "gcb_gpio";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&gpio_lan9645x 0 0 51>;
			interrupts-extended = <&lan9645x_irq 18>;
			interrupt-controller;
			#interrupt-cells = <2>;
			pinctrl-names = "default";
			pinctrl-0 = <&irq_pins>;

			irq_pins: irq-pins {
				pins = "GPIO_33";
				function = "irq0";
			};

			rgmii0_pins: rgmii0-pins {
				pins = "GPIO_16","GPIO_17","GPIO_18","GPIO_19","GPIO_20",
				       "GPIO_21","GPIO_22","GPIO_23","GPIO_24","GPIO_25",
				       "GPIO_26","GPIO_27";
				function = "rgmii";
			};

			lan9645x_i2c0_sda_pins: lan9645x-i2c0-sda-pins {
				pins = "GPIO_30";
				function = "i2c";
			};

			lan9645x_i2c0_scl0_pins: lan9645x-i2c0-scl0-pins {
				pins = "GPIO_31";
				function = "twi_scl_m";
				output-high;
			};

			lan9645x_i2c0_scl1_pins: lan9645x-i2c0-scl1-pins {
				pins = "GPIO_32";
				function = "twi_scl_m";
				output-high;
			};

			lan9645x_i2cmux_pins: lan9645x-i2cmux-pins {
				pins = "GPIO_31","GPIO_32";
				function = "gpio";
				output-low;
			};

			lan9645x_leds: lan9645x-leds-pins {
				pins = "GPIO_49", "GPIO_43", "GPIO_47", "GPIO_48", "GPIO_46", "GPIO_38", "GPIO_37", "GPIO_36";
				function = "phy_led";
			};

			lan9645x_ptp1_pins: lan9645x-ptp1-pins {
				pins = "GPIO_13";
				function = "ptp1";
			};

			lan9645x_ptp2_pins: lan9645x-ptp2-pins {
				pins = "GPIO_14";
				function = "ptp2";
			};
		};

		lan9645x_sgpio: gpio@40e0 {
			compatible = "microchip,lan9645x-sgpio";
			reg = <0>;
			reg-names = "gcb_sio";
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&lan9645x_clock>;
			status = "disabled";
			microchip,sgpio-port-ranges = <5 6>;
			bus-frequency = <1000000>;

			sgpio_lan9645x_in: gpio@0 {
				compatible = "microchip,sparx5-sgpio-bank";
				reg = <0>;
				gpio-controller;
				#gpio-cells = <3>;
				ngpios = <128>;
			};

			sgpio_lan9645x_out: gpio@1 {
				compatible = "microchip,sparx5-sgpio-bank";
				reg = <1>;
				gpio-controller;
				#gpio-cells = <3>;
				ngpios = <128>;
			};
		};

		lan9645x_serdes: serdes@b0000 {
			compatible = "microchip,lan9645x-serdes";
			reg = <0>, <0>;
			reg-names = "hsio", "chip_top";
			#phy-cells = <2>;
			status = "okay";
		};

	};
};

#include "lan9645x-port-delay-evb.dtsi"
